# config.env — paramètres locaux de la file (spécifiques à cette instance).
# C'est la SEULE source des noms concrets d'agents, des chemins et des canaux.
# Le dossier protocole/ ne référence jamais ce fichier ; ce sont les scripts
# et façades locaux qui le sourcent.
#
# Les variables sont EXPORTÉES : elles doivent rester visibles des
# sous-processus (le validateur, les watchers) après `source config.env`.

# --- Agents autorisés dans le champ `assigne` d'un ticket ---
# Consommé par protocole/scripts/check-ticket.sh via la variable d'environnement.
export QUEUE_ASSIGNEES="claude codex humain"

# --- Chemins ---
# Racine de la file (par défaut : la racine du repo courant).
export QUEUE_DIR="."

# --- Notification sortante (voir Phase 6) ---
# Canal : "ntfy" (défaut) ou "mail". Cible à renseigner (topic ntfy ou adresse).
export NOTIFY_CHANNEL="ntfy"
export NOTIFY_TARGET=""

# --- Budgets par invocation d'agent (voir Phase 6) ---
# Plafonnent tours/tokens pour éviter toute boucle infinie.
export BUDGET_CLAUDE="--max-turns 20"
export BUDGET_CODEX="--skip-git-repo-check"

# --- Garde-fou anti-boucle ---
# Profondeur maximale d'une chaîne de tickets créés par des agents (champ
# `parent`). Au-delà, l'assignation est forcée sur "humain".
export MAX_PROFONDEUR=3
